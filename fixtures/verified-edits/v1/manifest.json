{
  "schema_version": 1,
  "policy": "docs/verified-edits-policy.md",
  "fingerprint": "sha256(b'girder-node-fingerprint-v1\\0' + path + b'\\0' + source)",
  "placeholder": "base_commit '<HEAD>' is replaced by the harness",
  "fixtures": {
    "overload": [
      "Cargo.toml",
      "src/lib.rs"
    ],
    "overload-identical": [
      "Cargo.toml",
      "src/lib.rs"
    ],
    "basic": [
      "Cargo.toml",
      "src/lib.rs"
    ],
    "pybasic": [
      "app.py"
    ]
  },
  "cases": [
    {
      "id": "wrong-overload-by-fingerprint",
      "fixture": "overload",
      "plan": "plans/wrong-overload-by-fingerprint.json",
      "expected": {
        "outcome": "refused",
        "category": "wrong_overload",
        "failed_step": "s1"
      },
      "note": "addresses the inherent method but pins the trait impl's fingerprint"
    },
    {
      "id": "wrong-overload-by-delta",
      "fixture": "overload",
      "plan": "plans/wrong-overload-by-delta.json",
      "expected": {
        "outcome": "refused",
        "category": "wrong_overload",
        "failed_step": "s1"
      },
      "note": "baseline is true of the addressed node but the declared change names the same-named sibling"
    },
    {
      "id": "correct-overload-applies",
      "fixture": "overload",
      "plan": "plans/correct-overload-applies.json",
      "expected": {
        "outcome": "committed",
        "category": null,
        "failed_step": null
      },
      "note": "the counterpart of the wrong-overload plans: the trait impl, its own fingerprint and delta"
    },
    {
      "id": "identical-bodies-wrong-by-fingerprint",
      "fixture": "overload-identical",
      "plan": "plans/identical-bodies-wrong-by-fingerprint.json",
      "expected": {
        "outcome": "refused",
        "category": "wrong_overload",
        "failed_step": "s1"
      },
      "note": "both bodies are identical; only the path-bound fingerprint tells the overloads apart"
    },
    {
      "id": "identical-bodies-wrong-by-delta",
      "fixture": "overload-identical",
      "plan": "plans/identical-bodies-wrong-by-delta.json",
      "expected": {
        "outcome": "refused",
        "category": "wrong_overload",
        "failed_step": "s1"
      },
      "note": ""
    },
    {
