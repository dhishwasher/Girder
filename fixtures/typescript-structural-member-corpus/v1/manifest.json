{
  "version": 1,
  "name": "typescript-structural-member-identity-v1",
  "meaning": "Identity contract cases for TypeScript structural callable member identity policy v1. Proof-contract fixtures, not independent ground-truth samples and not additions to the published dispatch benchmark. expected_identity is the exact semantic path of the Function node that must exist at the marked member (null: no Function node may exist at that member's span).",
  "analysis_root": "fixtures/typescript-structural-member-corpus/v1",
  "marker_rule": "A marker comment immediately precedes the member's key (or signature). The marked definition is the next property/method/signature after the marker.",
  "stability_rule": "Every identity suffix after the module path that appears in both stability/before.ts and stability/after.ts must be equal for the same marker id; module paths differ only because the files differ.",
  "runtime": {
    "arrow.ts": "executed",
    "function-expression.ts": "executed",
    "method-shorthand.ts": "executed",
    "two-literals-shorthand.ts": "executed",
    "nested-literal.ts": "executed",
    "function-scope-owner.ts": "executed",
    "injective-segment.ts": "executed",
    "type-wrappers.ts": "executed",
    "owner-less.ts": "executed",
    "export-default.ts": "executed",
    "let-var-owner.ts": "executed",
    "keys.ts": "executed",
    "accessors-generators.ts": "executed",
    "shorthand-spread-proto.ts": "executed",
    "duplicate-keys.ts": "executed",
    "colliding-owners.ts": "executed",
    "other-owners.ts": "executed",
    "angle-assertion.ts": "skipped: angle-bracket assertion is not erasable by Node type stripping",
    "mutated-member.ts": "executed",
    "stability/before.ts": "executed",
    "stability/after.ts": "executed",
    "declaration-only.ts": "executed"
  },
  "cases": [
    {
      "file": "arrow.ts",
      "sha256": "f3290ae3491fc64de59ab4b70dcce2bf16382ca87e4ab1bd5d411ee134439ea7",
      "module_path": "crate::arrow",
      "members": [
        {
          "marker": "/* m:alice.name */",
          "form": "arrow",
          "expected_identity": "crate::arrow::alice::@object::name",
          "rule": "R1/R2: const owner, identifier key, arrow value."
        },
        {
          "marker": "/* m:asyncy.load */",
          "form": "arrow",
          "expected_identity": "crate::arrow::asyncy::@object::load",
          "rule": "async does not change identity."
        }
      ]
    },
    {
      "file": "function-expression.ts",
      "sha256": "fe73f4ee7fbe07c13d9f23759521bf5a51984939b96d36f444c91fb1e30a4bc3",
      "module_path": "crate::function-expression",
      "members": [
        {
          "marker": "/* m:alice.name */",
          "form": "function_expression",
          "expected_identity": "crate::function-expression::alice::@object::name",
          "rule": "Anonymous function expression; NamedEvaluation names it after the key."
        },
        {
          "marker": "/* m:alice.label */",
          "form": "function_expression",
          "expected_identity": "crate::function-expression::alice::@object::label",
          "rule": "Named function expression: identity comes from the property key (how callers reach it), never from `inner`, which is bound only inside its own body."
        }
      ]
    },
    {
