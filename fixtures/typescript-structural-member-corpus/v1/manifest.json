          "marker": "/* m:spread-before.name */",
          "form": "arrow",
          "expected_identity": null,
          "rule": "U6: refused even though this own member wins at runtime; v1 does not order-reason about spreads."
        },
        {
          "marker": "/* m:proto.name */",
          "form": "arrow",
          "expected_identity": null,
          "rule": "U6: a `__proto__` entry refuses the literal."
        },
        {
          "marker": "/* m:string-proto.name */",
          "form": "arrow",
          "expected_identity": null,
          "rule": "U6: `'__proto__'` (non-computed string key) is also a prototype setter."
        }
