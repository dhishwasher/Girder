{
  "name": "girder-mcp",
  "version": "0.2.3",
  "description": "Semantic-graph MCP server for AI coding agents: read one function instead of a whole file, find a declaration without grep, and select only the tests a change can reach.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "code-search",
    "semantic-graph",
    "claude",
    "cursor",
    "context"
  ],
  "homepage": "https://github.com/dhishwasher/Girder#readme",
  "bugs": "https://github.com/dhishwasher/Girder/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhishwasher/Girder.git",
    "directory": "npm"
  },
  "license": "BUSL-1.1",
  "mcpName": "io.github.dhishwasher/girder",
  "type": "commonjs",
  "bin": {
    "girder-mcp": "bin/girder-mcp.js",
    "girder": "bin/girder.js"
  },
  "files": [
    "bin/",
    "install.js",
    "resolve.js",
    "README.md"
  ],
  "scripts": {
