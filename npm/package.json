{
  "name": "girder-mcp",
  "version": "0.4.0",
  "description": "Saves AI coding-agent context: a local semantic-graph MCP server that gives the agent exactly the code it needs instead of whole files. Also provides conservative change-impact/test selection.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "code-search",
    "semantic-graph",
    "claude",
    "cursor",
    "context"
  ],
  "homepage": "https://github.com/dhishwasher/Girder#readme",
  "bugs": "https://github.com/dhishwasher/Girder/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhishwasher/Girder.git",
    "directory": "npm"
  },
  "license": "Apache-2.0",
  "mcpName": "io.github.dhishwasher/girder",
  "type": "commonjs",
  "bin": {
    "girder-mcp": "bin/girder-mcp.js",
    "girder": "bin/girder.js"
  },
  "files": [
    "bin/",
    "hooks/",
    "install.js",
    "resolve.js",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
